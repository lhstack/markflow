{
  "defaultBaseUrl": "https://api.openai.com/v1",
  "writeActions": [
    {
      "mode": "append",
      "marker": "[[ACTION:append]]",
      "payloadFormat": "直接输出要写入空文档首稿或追加到文档末尾的 Markdown 内容。",
      "example": "[[ACTION:append]]\n新增的一段 Markdown 内容\n[[/ACTION]]"
    },
    {
      "mode": "replace",
      "marker": "[[ACTION:replace]]",
      "payloadFormat": "直接输出整篇替换后的完整 Markdown 正文，仅在确实需要整体覆盖全文时使用。",
      "example": "[[ACTION:replace]]\n# 新正文标题\n...\n[[/ACTION]]"
    }
  ],
  "taskAnalysis": {
    "modes": ["chat", "plan"],
    "complexities": ["low", "medium", "high"],
    "intents": ["conversation", "execution"],
    "writeScopes": ["partial", "full"]
  },
  "routes": [
    {
      "route": "home.overview",
      "aliases": ["home.overview", "home", "overview"],
      "path": "/",
      "description": "项目概览页，展示当前用户的所有项目卡片。",
      "params": []
    },
    {
      "route": "home.project",
      "aliases": ["home.project", "project"],
      "path": "/?project={project_id}",
      "description": "进入指定项目并展示左侧文档树，主区域停留在项目工作区。",
      "params": ["project_id 或 project_name"]
    },
    {
      "route": "home.doc",
      "aliases": ["home.doc", "doc", "node"],
      "path": "/?project={project_id}&doc={node_id}",
      "description": "进入指定项目并打开某个 Markdown 文档编辑页。",
      "params": ["project_id 或 project_name", "node_id 或 node_path 或 node_name"],
      "nodeType": "doc"
    },
    {
      "route": "home.dir",
      "aliases": ["home.dir", "dir"],
      "path": "/?project={project_id}&doc={node_id}",
      "description": "进入指定项目并打开某个目录详情页。",
      "params": ["project_id 或 project_name", "node_id 或 node_path 或 node_name"],
      "nodeType": "dir"
    },
    {
      "route": "login",
      "aliases": ["login"],
      "path": "/login",
      "description": "登录页。",
      "params": []
    },
    {
      "route": "register",
      "aliases": ["register"],
      "path": "/register",
      "description": "注册页。",
      "params": []
    },
    {
      "route": "login.2fa",
      "aliases": ["login.2fa"],
      "path": "/login/2fa",
      "description": "两步验证页。",
      "params": []
    },
    {
      "route": "share",
      "aliases": ["share"],
      "path": "/s/{token}",
      "description": "分享文档页。",
      "params": ["share_token"]
    }
  ],
  "toolPolicies": [
    { "name": "get_current_page_state", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "list_page_routes", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "navigate_to_page", "stagePolicy": "mutation", "capabilities": ["navigate"] },
    { "name": "update_profile", "stagePolicy": "mutation", "capabilities": ["update"] },
    { "name": "list_uploads", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "delete_uploads", "stagePolicy": "mutation", "capabilities": ["delete"] },
    { "name": "list_projects", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "open_project", "stagePolicy": "observation", "capabilities": ["read", "navigate"] },
    { "name": "create_project", "stagePolicy": "mutation", "capabilities": ["create"] },
    { "name": "update_project", "stagePolicy": "mutation", "capabilities": ["update"] },
    { "name": "delete_projects", "stagePolicy": "mutation", "capabilities": ["delete"] },
    { "name": "execute_browser_javascript", "stagePolicy": "mutation", "capabilities": ["execute"] },
    { "name": "get_project_tree", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "create_tree_node", "stagePolicy": "mutation", "capabilities": ["create"] },
    { "name": "move_tree_node", "stagePolicy": "mutation", "capabilities": ["move"] },
    { "name": "open_tree_node", "stagePolicy": "observation", "capabilities": ["read", "navigate"] },
    { "name": "read_document", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "read_editor_snapshot", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "rewrite_document_section", "stagePolicy": "mutation", "capabilities": ["update"] },
    { "name": "replace_document_block", "stagePolicy": "mutation", "capabilities": ["update"] },
    { "name": "replace_document_blocks", "stagePolicy": "mutation", "capabilities": ["update"] },
    { "name": "swap_document_sections", "stagePolicy": "mutation", "capabilities": ["update"] },
    { "name": "save_current_document", "stagePolicy": "mutation", "capabilities": ["save"] },
    { "name": "update_tree_node_meta", "stagePolicy": "mutation", "capabilities": ["update"] },
    { "name": "delete_tree_nodes", "stagePolicy": "mutation", "capabilities": ["delete"] },
    { "name": "get_markdown_editor_runtime", "stagePolicy": "observation", "capabilities": ["read"] },
    { "name": "get_browser_runtime", "stagePolicy": "observation", "capabilities": ["read"] }
  ]
}
