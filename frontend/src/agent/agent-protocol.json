{
  "defaultBaseUrl": "https://api.openai.com/v1",
  "taskAnalysis": {
    "modes": [
      "chat",
      "plan"
    ],
    "complexities": [
      "low",
      "medium",
      "high"
    ],
    "intents": [
      "conversation",
      "execution"
    ],
    "writeScopes": [
      "partial",
      "full"
    ]
  },
  "routes": [
    {
      "route": "home.overview",
      "aliases": [
        "home.overview",
        "home",
        "overview"
      ],
      "path": "/",
      "description": "项目概览页，展示当前用户的所有项目卡片。",
      "params": []
    },
    {
      "route": "home.project",
      "aliases": [
        "home.project",
        "project"
      ],
      "path": "/?project={project_id}",
      "description": "进入指定项目并展示左侧文档树，主区域停留在项目工作区。",
      "params": [
        "project_id 或 project_name"
      ]
    },
    {
      "route": "home.doc",
      "aliases": [
        "home.doc",
        "doc",
        "node"
      ],
      "path": "/?project={project_id}&doc={node_id}",
      "description": "进入指定项目并打开某个 Markdown 文档编辑页。",
      "params": [
        "project_id 或 project_name",
        "node_id 或 node_path 或 node_name"
      ],
      "nodeType": "doc"
    },
    {
      "route": "home.dir",
      "aliases": [
        "home.dir",
        "dir"
      ],
      "path": "/?project={project_id}&doc={node_id}",
      "description": "进入指定项目并打开某个目录详情页。",
      "params": [
        "project_id 或 project_name",
        "node_id 或 node_path 或 node_name"
      ],
      "nodeType": "dir"
    },
    {
      "route": "login",
      "aliases": [
        "login"
      ],
      "path": "/login",
      "description": "登录页。",
      "params": []
    },
    {
      "route": "register",
      "aliases": [
        "register"
      ],
      "path": "/register",
      "description": "注册页。",
      "params": []
    },
    {
      "route": "login.2fa",
      "aliases": [
        "login.2fa"
      ],
      "path": "/login/2fa",
      "description": "两步验证页。",
      "params": []
    },
    {
      "route": "share",
      "aliases": [
        "share"
      ],
      "path": "/s/{token}",
      "description": "分享文档页。",
      "params": [
        "share_token"
      ]
    }
  ],
  "toolPolicies": [
    {
